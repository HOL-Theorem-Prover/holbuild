#compdef holbuild
# Zsh completion for holbuild. Candidates come from `holbuild __complete`;
# when it offers none (a file argument, say), zsh completes file names.

local -a candidates
candidates=("${(@f)$(${words[1]} __complete "${(@)words[2,CURRENT-1]}" "$PREFIX" 2>/dev/null)}")
candidates=(${candidates:#})
if (( ${#candidates} )); then
  compadd -- "${candidates[@]}"
else
  _files
fi
